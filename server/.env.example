PORT=5000
NODE_ENV=development

# --- Database (TiDB Cloud or MySQL 8) ---------------------------------
# Either a single URL...
# DATABASE_URL=mysql://USER:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/aranya_resort
# ...or the individual parts:
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=aranya_resort
# TiDB Cloud requires TLS
DB_SSL=true
# DB_POOL_SIZE=10

# --- Auth ---------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Public site URL (CORS + links in emails), no trailing slash
CLIENT_URL=http://localhost:5173

# --- Email (optional; without SMTP_HOST emails are skipped and logged) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=Aranya Palace Resort & Spa <stay@aranyapalace.in>
# ADMIN_NOTIFY_EMAIL=frontdesk@aranyapalace.in

# --- Razorpay (optional; without keys "Pay online" is hidden) -----------
# Use rzp_test_ keys for test mode (nothing is charged).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
